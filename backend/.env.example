# ============================================================
#  riots.wtf backend — environment variables
#  ------------------------------------------------------------
#  HOW THIS WORKS:
#   • Copy this file to ".env" for LOCAL testing.
#   • For PRODUCTION, set these SAME keys in Railway
#       (your service -> Variables tab). You do NOT upload a file.
#   • These are SECRETS. Never commit .env, never put them on Vercel.
#  Values marked (required) must be filled for that feature to work.
#  Anything left blank just disables that one feature.
# ============================================================

# ---- Server ----
PORT=8080
NODE_ENV=production

# (required) Comma-separated list of your frontend URLs allowed to call the API.
# Local dev: keep the localhost ones. Production: your Vercel URL(s).
# Example: https://riots.wtf,https://riots-wtf.vercel.app
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ---- Security ----
# (required) Long random string. Generate one: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string

# (required) The admin key you type into the dashboard to unlock admin mode.
# Just pick a strong random string and keep it secret.
ADMIN_KEY=change_me_to_a_strong_random_string

# (optional) Extra anti-scraping token. If set, the site must send the SAME
# value (config.js CLIENT_TOKEN) on API calls. Leave blank to disable.
FRONTEND_TOKEN=

# (optional) Block API calls with no Origin/Referer in production (curl/bots).
BLOCK_NO_ORIGIN=true

# ---- Discord login (dashboard) ----
# From https://discord.com/developers/applications -> your app.
# OAuth2 -> add redirect: https://YOUR_RAILWAY_URL/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://YOUR_RAILWAY_URL/auth/discord/callback
# Where users land after logging in (your live dashboard page):
DASHBOARD_URL=https://YOUR_VERCEL_URL/dashboard.html

# ---- Keys: LuaProt ----
# (required for key features) From your LuaProt dashboard.
# IMPORTANT: whitelist your Railway service IP on LuaProt or requests are blocked.
LUAPROT_API_KEY=
LUAPROT_HUB_ID=
LUAPROT_BASE_URL=https://luaprot.net

# ---- Komerza ----
# (required for live stock) SECRET Bearer API key — server-side ONLY.
KOMERZA_API_KEY=
# (required for live stock) Your store id.
KOMERZA_STORE_ID=e2f2de20-0a61-4634-aaba-a2e4d476bcd9
# (optional) Default product id used for the store-wide stock badge. You can
# leave this blank — each product carries its own id from the admin panel.
KOMERZA_PRODUCT_ID=
KOMERZA_BASE_URL=https://api.komerza.com
# (optional) Webhook signing secret — verifies purchase webhooks are genuine.
KOMERZA_WEBHOOK_SECRET=

# ---- Storage ----
# Where the JSON data (products, devlog, status, links, discounts, referrals,
# tickets) is written.
#
# IMPORTANT (Railway): the normal container filesystem is EPHEMERAL — it is
# wiped on every redeploy/restart, so anything saved there (linked keys,
# products, discount codes, referrals) DISAPPEARS. To make data persist you
# MUST attach a Railway Volume and point DATA_DIR at its mount path:
#   1. Railway -> your service -> Volumes -> New Volume
#   2. Mount path: /data
#   3. Set DATA_DIR=/data
DATA_DIR=/data
